{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	file_server

	@static path *.css *.js *.webp *.png *.jpg *.jpeg *.svg *.woff2
	header @static Cache-Control "public, max-age=31536000, immutable"

	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
}
